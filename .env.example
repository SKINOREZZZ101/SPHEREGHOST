# =============================================================================
# Ghost Sphere — stack configuration (developed by Ghost OS)
# Copy to ".env" next to docker-compose.yml and adjust before `docker compose up`.
#   cp .env.example .env
# Everything has sane defaults; the ONLY value you usually must change for a
# real server is SUB_PUBLIC_DOMAIN (so subscription links point at your host).
# =============================================================================

# ---- Public web port (the panel UI + API are served here) ----
GHOST_SPHERE_PORT=8080

# ---- Subscription delivery -------------------------------------------------
# Public address clients use to fetch their subscription. Must be reachable
# from the outside. Use your server IP or domain, KEEP the "/api/sub" suffix.
#   IP example     : 188.127.235.36:8080/api/sub
#   domain example : panel.example.com/api/sub      (behind HTTPS reverse proxy)
SUB_PUBLIC_DOMAIN=localhost:8080/api/sub

# Panel domain (used for cookies / links). IP or domain, no scheme.
PANEL_DOMAIN=localhost

# ---- Database --------------------------------------------------------------
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghost_sphere_pg
POSTGRES_DB=ghostsphere

# ---- Secrets (CHANGE THESE FOR PRODUCTION) ---------------------------------
JWT_AUTH_SECRET=ghost_sphere_auth_secret_0001_change_in_prod
JWT_API_TOKENS_SECRET=ghost_sphere_api_secret_0001_change_in_prod

# ---- Metrics basic-auth ----------------------------------------------------
METRICS_USER=admin
METRICS_PASS=admin
