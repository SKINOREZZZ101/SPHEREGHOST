# Ghost Sphere Core — gateway configuration
# The gateway is stateless: panel credentials are forwarded per-request by the
# web client (X-GS-Panel-* headers), so it can serve multiple Remnawave panels.

# Port the gateway listens on
PORT=8088

# Optional: pin a default panel (used only if you build server-side automations)
# REMNAWAVE_PANEL_URL=https://panel.example.com
# REMNAWAVE_API_TOKEN=
