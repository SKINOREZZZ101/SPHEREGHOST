# Ghost Sphere BFF — API layer for the premium web UI.
# It forwards the admin JWT (from login) to the bundled Ghost Sphere Engine and
# shapes engine responses into convenient DTOs for the interface.

# Port the BFF listens on
PORT=8088

# URL of the bundled Ghost Sphere Engine (the forked Remnawave backend).
# In docker compose this is the engine service: http://backend:3000
ENGINE_URL=http://127.0.0.1:3000
